# Copia questo file in .env.local e compila i valori reali.
# NON committare file con password/token.

# URL app (dev)
NEXT_PUBLIC_APP_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# JWT (usa un secret lungo e unico in ogni ambiente)
JWT_SECRET=YOUR_JWT_SECRET_CHANGE_ME
JWT_EXPIRES_IN=24h

# --- Database gestionale / logistica ---
# Locale (LAN Proxmox): host=192.168.0.11 port=3306
# Vercel (tunnel ngrok): host=10.tcp.eu.ngrok.io port=21187
DB_GESTIONE_HOST=10.tcp.eu.ngrok.io
DB_GESTIONE_PORT=21187
DB_GESTIONE_USER=YOUR_DB_USER
DB_GESTIONE_PASS=YOUR_DB_PASSWORD
DB_GESTIONE_NAME=gestionelogistica

# --- Database viaggi ---
# Stesso server MySQL; database distinto
DB_VIAGGI_HOST=10.tcp.eu.ngrok.io
DB_VIAGGI_PORT=21187
DB_VIAGGI_USER=YOUR_DB_USER
DB_VIAGGI_PASS=YOUR_DB_PASSWORD
DB_VIAGGI_NAME=viaggi_db

# SSL MySQL (di solito OFF con tunnel ngrok / LAN). Solo se necessario:
# DB_VIAGGI_SSL=true
# DB_VIAGGI_SSL_REJECT_UNAUTHORIZED=false

# --- Backup management (stesso MySQL, database dedicato) ---
MYSQL_HOST=10.tcp.eu.ngrok.io
MYSQL_PORT=21187
MYSQL_USER=YOUR_DB_USER
MYSQL_PASSWORD=YOUR_DB_PASSWORD
MYSQL_DATABASE=backup_management
# MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 8.4\bin

# Vercel Blob (opzionale)
# BLOB_READ_WRITE_TOKEN=YOUR_BLOB_TOKEN

# Security
BCRYPT_SALT_ROUNDS=12
SESSION_CLEANUP_INTERVAL=3600000
